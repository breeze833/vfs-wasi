    "./vfs": "./src/vfs.js",
    "./wasi-fs": "./src/wasi-fs.js",
    "./sync": "./src/sync.js"
  },
  "bin": {
    "vfs-pack": "./bin/vfs-pack.js",
    "vfs-inspect": "./bin/vfs-inspect.js"
  },
  "scripts": {
    "test": "node test/ssys.test.js && node test/vfs.test.js && node test/wasi-fs.test.js && node test/sync.test.js"
  },
  "files": [
    "src",
    "bin",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
